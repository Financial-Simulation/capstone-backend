{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsProductionOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::260172549184:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:Financial-Simulation/capstone-backend:environment:production"
        }
      }
    }
  ]
}
